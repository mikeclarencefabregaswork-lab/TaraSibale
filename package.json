{
  "name": "tarasibale",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "Frontend",
    "Backend"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n frontend,backend -c cyan,green \"npm run dev --workspace Frontend\" \"npm run dev --workspace Backend\"",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace Backend",
    "db:migrate": "npm run db:migrate --workspace Backend",
    "db:seed": "npm run db:seed --workspace Backend",
    "admin:promote": "npm run admin:promote --workspace Backend --",
    "db:start": "sudo systemctl start postgresql",
    "db:stop": "sudo systemctl stop postgresql",
    "db:status": "pg_isready -h 127.0.0.1 -p 5432",
    "graph:build": "graphify extract . --code-only --no-cluster --max-workers 2 && graphify cluster-only . --no-label && node scripts/enrich-graph.mjs",
    "graph:obsidian": "node scripts/export-obsidian.mjs",
    "graph:context": "node scripts/enrich-graph.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6"
  }
}
