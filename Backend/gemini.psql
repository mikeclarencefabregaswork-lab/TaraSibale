-- Bootstrap only: run against postgres as the existing gemini.psql role
-- (with CREATEDB), or as a PostgreSQL administrator. Never stores a password.
-- Example: psql -X -h 127.0.0.1 -U gemini.psql -d postgres -f Backend/gemini.psql
-- Run outside a transaction: CREATE DATABASE cannot run in a transaction.
\set ON_ERROR_STOP on

-- Fail clearly if the requested existing role is absent; do not invent a role
-- or change its password or privileges.
DO $$
BEGIN
  IF NOT EXISTS (SELECT FROM pg_roles WHERE rolname = 'gemini.psql') THEN
    RAISE EXCEPTION 'Existing PostgreSQL role gemini.psql was not found';
  END IF;
  IF EXISTS (
    SELECT FROM pg_database
    WHERE datname = 'tarasibale'
      AND pg_get_userbyid(datdba) <> 'gemini.psql'
  ) THEN
    RAISE EXCEPTION 'tarasibale already exists under another owner; review before continuing';
  END IF;
END
$$;

SELECT format('CREATE DATABASE %I OWNER %I', 'tarasibale', 'gemini.psql')
WHERE NOT EXISTS (SELECT FROM pg_database WHERE datname = 'tarasibale')
\gexec

-- Schema and seed data are managed by npm run db:migrate / db:seed.
SELECT datname, pg_get_userbyid(datdba) AS owner
FROM pg_database WHERE datname = 'tarasibale';
